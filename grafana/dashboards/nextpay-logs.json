{
  "title": "NextPay - Application Logs",
  "uid": "nextpay-logs",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Live Application Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{service=\"api\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      }
    },
    {
      "id": 2,
      "title": "Error Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{service=\"api\"} |= \"ERROR\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "Warning Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{service=\"api\"} |= \"WARN\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Exceptions",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{service=\"api\"} |~ \"Exception|RuntimeException|SQLException|NullPointerException|NoResourceFoundException|GlobalExceptionHandler\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "Authentication & Security",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{service=\"api\"} |~ \"JWT|Authentication|Unauthorized|AccessDenied|Login|Bearer\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "Payment Events",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{service=\"api\"} |~ \"PaymentController|PaymentService|PaymentStatisticsService|Webhook|PaymentRepository\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "title": "User Management",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{service=\"api\"} |~ \"UserController|UserService|Role|AuthController|AuthService\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "title": "Database",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{service=\"api\"} |~ \"Hibernate|Flyway|Hikari|JDBC|Datasource|PostgreSQL\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 9,
      "title": "Application Lifecycle",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "expr": "{service=\"api\"} |~ \"Starting|Started|Tomcat|Shutdown|Application|Spring Boot\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      }
    }
  ]
}